{
  "version": 2,
  "capabilities": [
    "public-internet",
    "oidc",
    "credential-auth",
    "public-cloud-deploy",
    "public-pages-deploy",
    "public-registry-publish",
    "public-build",
    "public-release-publish",
    "deployment-credentials",
    "public-api-dispatch",
    "private-network",
    "runner-managed-identity",
    "delegated-runner",
    "public-ci",
    "windows-runtime",
    "macos-runtime",
    "untrusted-fork-safe",
    "multi-os-matrix"
  ],
  "classes": [
    {
      "runner_class": "github-hosted-linux",
      "runs_on": "ubuntu-latest",
      "use_for": [
        "lint",
        "unit-test",
        "docs",
        "repository-validation",
        "public-ci",
        "OIDC or credential-auth public cloud deployment",
        "credentialed public API publication"
      ],
      "required_capabilities": [
        "public-internet"
      ],
      "recommendation_priority": 0
    },
    {
      "runner_class": "github-hosted-windows",
      "runs_on": "windows-latest",
      "use_for": [
        "windows-validation",
        "cross-platform-compatibility"
      ],
      "required_capabilities": [
        "windows-runtime",
        "public-internet"
      ],
      "recommendation_priority": 80
    },
    {
      "runner_class": "github-hosted-macos",
      "runs_on": "macos-latest",
      "use_for": [
        "macos-validation",
        "cross-platform-compatibility"
      ],
      "required_capabilities": [
        "macos-runtime",
        "public-internet"
      ],
      "recommendation_priority": 80
    },
    {
      "runner_class": "self-hosted-linux",
      "runs_on": "group + self-hosted labels",
      "use_for": [
        "deploy",
        "release",
        "private-network",
        "runner-managed-identity"
      ],
      "required_capabilities_any": [
        "private-network",
        "runner-managed-identity"
      ],
      "recommendation_priority": 100
    },
    {
      "runner_class": "configurable-deploy",
      "runs_on": "${{ vars.RUNNER_DEPLOY || 'ubuntu-latest' }}",
      "use_for": [
        "transition-state routing",
        "deploy workflows with safe fallback"
      ],
      "required_capabilities": [
        "private-network",
        "deployment-credentials"
      ],
      "recommend_for_audit": false,
      "recommendation_priority": 0
    },
    {
      "runner_class": "configurable-release",
      "runs_on": "${{ vars.RUNNER_RELEASE || vars.RUNNER_DEPLOY || 'ubuntu-latest' }}",
      "use_for": [
        "release and publish workflows with a dedicated lane override"
      ],
      "required_capabilities": [
        "private-network",
        "deployment-credentials"
      ],
      "recommend_for_audit": false,
      "recommendation_priority": 0
    },
    {
      "runner_class": "github-hosted-matrix",
      "runs_on": "${{ matrix.os }}",
      "use_for": [
        "multi-os validation matrices"
      ],
      "required_capabilities": [
        "multi-os-matrix",
        "public-internet"
      ],
      "recommendation_priority": 90
    },
    {
      "runner_class": "reusable-workflow",
      "runs_on": "job-level uses: ./.github/workflows/<reusable>.yml",
      "use_for": [
        "delegated runner selection through reusable workflows"
      ],
      "required_capabilities": [
        "delegated-runner"
      ],
      "recommendation_priority": 110
    }
  ]
}
