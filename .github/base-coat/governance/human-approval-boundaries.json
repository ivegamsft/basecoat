        "medium": false,
        "high": false,
        "critical": true
      },
      "production_release_approval_required": true
    },
    "team-dev": {
      "issue_approval_signal_required": true,
      "pr_approval_required_by_risk": {
        "low": false,
        "medium": true,
        "high": true,
        "critical": true
      },
      "production_release_approval_required": true
    },
    "regulated-team": {
      "issue_approval_signal_required": true,
      "pr_approval_required_by_risk": {
        "low": true,
        "medium": true,
        "high": true,
        "critical": true
      },
      "production_release_approval_required": true
    }
  }
}
