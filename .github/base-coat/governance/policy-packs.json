{
  "default_profile": "solo-dev",
  "production_release_paths": [
    ".github/workflows/close-production-issues.yml",
    ".github/workflows/docs-production.yml",
    ".github/workflows/extension-deploy.yml",
    ".github/workflows/mcp-deploy.yml",
    ".github/workflows/publish-to-production.yml"
  ],
  "production_environment": {
    "name": "production",
    "approval_boundary": "production_environment_approval",
    "workflow_bindings": {
      ".github/workflows/close-production-issues.yml": {
        "job": "close-issues",
        "expected_job_environment": "production",
        "expected_workflow_sha256": "84a5ae7f4ebd7d63aaea962d041378441a0f7641783c63603b8e741cf6c118ad"
      },
      ".github/workflows/docs-production.yml": {
        "job": "dispatch-production-docs",
        "expected_job_environment": "production",
        "expected_workflow_sha256": "7de5c4012fa2eb55c1a708f0e27232a1c99ceebd827cf32c114f76100981444e"
      },
      ".github/workflows/extension-deploy.yml": {
        "job": "deploy",
        "expected_job_environment": "${{ github.event_name == 'workflow_dispatch' && ((github.event.inputs.environment == 'prod' || github.event.inputs.environment == 'production') && 'production' || github.event.inputs.environment) || 'production' }}",
        "expected_workflow_sha256": "80f5efeee1ab3d1ac961bf4b6794a0b014ea2e3c6c4f7badf188f7e614448b13"
      },
      ".github/workflows/mcp-deploy.yml": {
        "job": "deploy",
        "expected_job_environment": "${{ github.event_name == 'pull_request' && 'staging' || (github.event_name == 'workflow_dispatch' && ((github.event.inputs.environment == 'prod' || github.event.inputs.environment == 'production') && 'production' || github.event.inputs.environment) || 'production') }}",
        "expected_workflow_sha256": "ebf075d3414f77c8f8817b109a61c7c95151976f2851a26283d206025b6b50b8"
      },
      ".github/workflows/publish-to-production.yml": {
        "job": "publish",
        "expected_job_environment": "production",
        "expected_workflow_sha256": "e2dc99fab877dc94f204c2c5b0dfb89ba8df10bed18df725e9e21eea192b2768"
      }
    }
  },
  "profiles": {
    "solo-dev": {
      "description": "Single maintainer optimization with strict checks and explicit critical-risk acknowledgement.",
      "main": {
        "reconcile_merge_eligibility": true,
        "required_checks": [
          "lint-and-validate",
          "test",
          "validate-commit-messages",
          "validate-unix",
          "validate-windows",
          "release-label-gate"
        ],
        "merge_queue_posture": "deferred",
        "automated_review": {
          "required": true,
          "reviewer_logins": [
            "copilot-pull-request-reviewer[bot]"
          ],
          "accepted_states": [
            "COMMENTED",
            "APPROVED"
          ]
        },
        "required_approvals_by_risk_tier": {
          "low": 0,
          "medium": 0,
          "high": 0,
          "critical": 0
        },
        "required_maintainer_acknowledgement_by_risk_tier": {
          "low": false,
          "medium": false,
          "high": false,
          "critical": true
        }
      },
      "cloud_agent": {
        "auto_approve_workflow_runs": true,
        "required_status_checks": [
          "Agent merge guardrails"
        ]
      },
      "override_path": "Open a governance issue with label governance and include risk, owner, expiry, and rollback plan."
    },
    "team-dev": {
      "description": "Collaborative team defaults with tiered human approval for medium/high-risk changes.",
      "main": {
        "reconcile_merge_eligibility": true,
        "required_checks": [
          "lint-and-validate",
          "test",
          "validate-commit-messages",
          "validate-unix",
          "validate-windows",
          "release-label-gate"
        ],
        "merge_queue_posture": "deferred",
        "automated_review": {
          "required": false,
          "reviewer_logins": [],
          "accepted_states": []
        },
        "required_approvals_by_risk_tier": {
          "low": 0,
          "medium": 1,
          "high": 1,
          "critical": 1
        },
        "required_maintainer_acknowledgement_by_risk_tier": {
          "low": false,
          "medium": false,
          "high": false,
          "critical": false
        }
      },
      "cloud_agent": {
        "auto_approve_workflow_runs": true,
        "required_status_checks": [
          "Agent merge guardrails"
        ]
      },
      "override_path": "Use temporary exception issue approved by repo owner; expires within one sprint."
    },
    "regulated-team": {
      "description": "Strictest controls for critical, production, and security-sensitive changes.",
      "main": {
        "reconcile_merge_eligibility": true,
        "required_checks": [
          "lint-and-validate",
          "test",
          "validate-commit-messages",
          "validate-unix",
          "validate-windows",
          "release-label-gate",
          "prd-spec-gate"
        ],
        "merge_queue_posture": "required",
        "automated_review": {
          "required": false,
          "reviewer_logins": [],
          "accepted_states": []
        },
        "required_approvals_by_risk_tier": {
          "low": 1,
          "medium": 1,
          "high": 2,
          "critical": 2
        },
        "required_maintainer_acknowledgement_by_risk_tier": {
          "low": false,
          "medium": false,
          "high": false,
          "critical": false
        }
      },
      "cloud_agent": {
        "auto_approve_workflow_runs": false,
        "required_status_checks": [
          "Agent merge guardrails",
          "prd-spec-gate"
        ]
      },
      "override_path": "Escalate through security/governance issue plus recorded incident or change-approval ticket."
    }
  },
  "risk_tier_routing": {
    "low": [
      "docs/",
      ".github/ISSUE_TEMPLATE/",
      ".github/PULL_REQUEST_TEMPLATE.md"
    ],
    "medium": [
      "agents/",
      "skills/",
      "instructions/",
      "prompts/",
      "scripts/",
      "tests/"
    ],
    "high": [
      ".github/workflows/",
      "docs/reference/governance.md",
      "docs/reference/governance-contract.md",
      "docs/reference/branch-protection.md",
      "docs/reference/environment-protection.md",
      "docs/reference/risk-tier-policy.md"
    ],
    "critical": [
      "iac/",
      ".github/governance/",
      ".github/base-coat/governance/",
      ".github/environment-protection-production.json",
      ".github/workflows/pr-auto-merge-executor.yml",
      ".github/workflows/basecoat-pr-auto-merge-executor.yml",
      ".github/base-coat/workflows/pr-auto-merge-executor.yml",
      ".github/workflows/portal-deploy.yml",
      ".github/workflows/mcp-deploy.yml",
      ".github/workflows/extension-deploy.yml"
    ]
  }
}
