{
  "name": "production",
  "environment": "production",
  "deployment_branch_policy": {
    "protected_branches": false,
    "custom_branch_policies": true
  },
  "branch_policies": [
    {
      "pattern": "main",
      "type": "branch"
    },
    {
      "pattern": "v*",
      "type": "tag"
    }
  ],
  "protection_rules": {
    "require_deployment_approvals": {
      "enabled": true,
      "required_reviewers": 1,
      "dismissal_restrictions": {
        "users": [],
        "teams": []
      }
    },
    "wait_timer": 0,
    "prevent_self_review": false
  }
}
