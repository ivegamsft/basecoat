{
  "version": 1,
  "contracts": [
    {
      "workflow": "extension-deploy.yml",
      "job": "build-push",
      "allowed_runner_classes": [
        "github-hosted-linux",
        "configurable-deploy",
        "self-hosted-linux"
      ],
      "max_timeout_minutes": 20
    },
    {
      "workflow": "extension-deploy.yml",
      "job": "deploy",
      "allowed_runner_classes": [
        "github-hosted-linux",
        "configurable-deploy",
        "self-hosted-linux"
      ],
      "max_timeout_minutes": 20
    },
    {
      "workflow": "mcp-build.yml",
      "job": "build",
      "allowed_runner_classes": [
        "github-hosted-linux",
        "configurable-deploy",
        "self-hosted-linux"
      ],
      "max_timeout_minutes": 20
    },
    {
      "workflow": "mcp-deploy.yml",
      "job": "build-push",
      "allowed_runner_classes": [
        "github-hosted-linux",
        "configurable-deploy",
        "self-hosted-linux"
      ],
      "max_timeout_minutes": 20
    },
    {
      "workflow": "mcp-deploy.yml",
      "job": "deploy",
      "allowed_runner_classes": [
        "github-hosted-linux"
      ],
      "max_timeout_minutes": 20
    },
    {
      "workflow": "portal-deploy.yml",
      "job": "deploy",
      "allowed_runner_classes": [
        "github-hosted-linux",
        "configurable-deploy",
        "self-hosted-linux"
      ],
      "max_timeout_minutes": 20
    },
    {
      "workflow": "docs-production.yml",
      "job": "dispatch-production-docs",
      "allowed_runner_classes": [
        "github-hosted-linux"
      ],
      "max_timeout_minutes": 10
    },
    {
      "workflow": "close-production-issues.yml",
      "job": "close-issues",
      "allowed_runner_classes": [
        "github-hosted-linux"
      ],
      "max_timeout_minutes": 10
    }
  ]
}
