{
  "name": "@basecoat/portal-api",
  "version": "1.0.0",
  "description": "Basecoat Portal API - Governance, security audit, and compliance tracking",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:migrate": "typeorm migration:run -d dist/src/config/database.js",
    "db:rollback": "typeorm migration:revert -d dist/src/config/database.js",
    "db:generate": "typeorm migration:generate",
    "health-check": "node -e \"require('http').get('http://localhost:3000/health', (r) => console.log(r.statusCode === 200 ? 'HEALTHY' : 'UNHEALTHY'))\"",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "axios": "1.19.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "joi": "17.13.4",
    "jsonwebtoken": "9.0.3",
    "pg": "8.21.0",
    "typeorm": "1.1.0",
    "uuid": "11.1.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.19",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "prettier": "3.8.3",
    "supertest": "6.3.4",
    "ts-jest": "29.4.9",
    "tsc-alias": "1.8.17",
    "tsx": "4.22.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
