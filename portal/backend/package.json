{
  "name": "@basecoat/portal-backend",
  "version": "0.1.0",
  "description": "Basecoat Portal backend API server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "8.5.1",
    "express-session": "1.19.0",
    "helmet": "7.2.0",
    "jsonwebtoken": "9.0.3",
    "passport": "0.7.0",
    "passport-github2": "0.1.12",
    "pg": "8.20.0",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "winston": "3.19.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.39",
    "@types/passport": "1.0.17",
    "@types/passport-github2": "1.2.9",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "rimraf": "5.0.10",
    "sequelize-cli": "6.6.5",
    "sqlite3": "6.0.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
