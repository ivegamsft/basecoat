{
  "suite": "vscode-harness-benchmark-v1",
  "description": "VS Code harness benchmark corpus for multi-turn tool use and harness regressions.",
  "categories": [
    {
      "id": "multi_turn_tool_use",
      "description": "Model plans and executes bounded multi-step tool chains to resolve user intent.",
      "target_signals": [
        "resolution_rate",
        "prompt_tokens_avg",
        "completion_tokens_avg",
        "tool_calls_per_resolved_run",
        "p95_latency_ms"
      ]
    },
    {
      "id": "mcp_external_tools",
      "description": "Model correctly routes to MCP and external tools and handles schema-conformant arguments.",
      "target_signals": [
        "resolution_rate",
        "tool_calls_per_resolved_run",
        "p95_latency_ms"
      ]
    },
    {
      "id": "terminal_browser_interactions",
      "description": "Model handles terminal/browser loops with bounded retries and deterministic stop behavior.",
      "target_signals": [
        "resolution_rate",
        "tool_calls_per_resolved_run",
        "p95_latency_ms"
      ]
    },
    {
      "id": "loop_and_stop_conditions",
      "description": "Model exits appropriately on stop conditions, cancellations, and budget limits.",
      "target_signals": [
        "resolution_rate",
        "p95_latency_ms"
      ]
    }
  ],
  "cases": [
    {
      "id": "orchestrate-3-step-tool-chain",
      "category": "multi_turn_tool_use",
      "prompt": "Find failing tests, identify root cause, and propose a minimal patch.",
      "expected_outcome": "resolved",
      "required_behaviors": [
        "bounded_tool_rounds",
        "evidence_based_summary"
      ]
    },
    {
      "id": "route-to-mcp-and-recover",
      "category": "mcp_external_tools",
      "prompt": "Query MCP data, handle a schema mismatch, and retry with corrected arguments.",
      "expected_outcome": "resolved",
      "required_behaviors": [
        "correct_tool_selection",
        "argument_validation",
        "bounded_retry"
      ]
    },
    {
      "id": "terminal-run-with-follow-up",
      "category": "terminal_browser_interactions",
      "prompt": "Run tests in terminal, inspect failure output, and execute a focused retest.",
      "expected_outcome": "resolved",
      "required_behaviors": [
        "terminal_output_reflection",
        "targeted_follow_up"
      ]
    },
    {
      "id": "respect-stop-budget",
      "category": "loop_and_stop_conditions",
      "prompt": "Continue only while progress is made; stop when retry budget is exhausted.",
      "expected_outcome": "failed_limit_or_cancelled",
      "required_behaviors": [
        "stop_condition_compliance"
      ]
    }
  ]
}
