{
  "suite": "hrm-trm-memory-ab-v1",
  "cases": [
    {
      "id": "routing-with-context",
      "category": "cognitive-layer",
      "asset_path": "instructions/basecoat-10-core-hrm-execution.instructions.md",
      "assertions": {
        "required_contains": ["route", "confidence"],
        "forbidden_contains": ["ignore previous instructions"],
        "max_words": 120,
        "required_sections": ["Route"]
      },
      "baseline_response": "Route the task.",
      "enhanced_response": "Route: fast path when confidence is high. Route: explore when confidence is uncertain. Confidence determines the next layer.",
      "baseline_turns": 2,
      "enhanced_turns": 1,
      "mock_responses": ["Route the task.", "Route the task."]
    },
    {
      "id": "bounded-reflexion",
      "category": "cognitive-layer",
      "asset_path": "instructions/basecoat-10-core-trm-reflexion.instructions.md",
      "assertions": {
        "required_contains": ["Pass 1", "Pass 2", "budget"],
        "forbidden_contains": ["ignore previous instructions"],
        "max_words": 160,
        "required_sections": ["Pass 1", "Pass 2"]
      },
      "baseline_response": "Use one pass and continue.",
      "enhanced_response": "Pass 1 classifies intent. Pass 2 refines uncertain cases. Stop when the budget guard fires.",
      "baseline_turns": 2,
      "enhanced_turns": 1,
      "mock_responses": ["Use one pass and continue.", "Use one pass and continue."]
    }
  ]
}
