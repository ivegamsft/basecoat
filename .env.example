# Copy this file to .env before running docker compose up.

# PostgreSQL password used by the compose stack
POSTGRES_PASSWORD=<your-postgres-password>

# JWT signing secret for the backend
JWT_SECRET=<your-jwt-secret>

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>

# ---------------------------------------------------------------------------
# Telemetry — App Insights (BaseCoat onboarding telemetry pack)
# Docs: docs/operations/onboarding-telemetry-readiness.md
# ---------------------------------------------------------------------------

# App Insights connection string (preferred over instrumentation key).
# Obtain from: Azure Portal > Application Insights > Overview > Connection String.
# Format: InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/
# Required for: regulated-team profile. Recommended for team-dev.
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-app-insights-connection-string>

# App Insights instrumentation key (legacy; use connection string where possible).
# APPLICATIONINSIGHTS_INSTRUMENTATION_KEY=<your-instrumentation-key>

# GitHub token with read:org scope for Copilot metrics and reviewer_closure metric.
# Set as a repo or org secret named COPILOT_METRICS_TOKEN in GitHub Actions.
# COPILOT_METRICS_TOKEN=<your-pat-with-read-org-scope>
