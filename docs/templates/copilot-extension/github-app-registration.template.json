{
  "appName": "BaseCoat Copilot Extension",
  "owner": "IBuySpy-Shared",
  "homepageUrl": "https://github.com/IBuySpy-Shared/basecoat",
  "extensionBackendBaseUrl": "https://<aca-app>.<region>.azurecontainerapps.io",
  "callbackUrl": "https://<aca-app>.<region>.azurecontainerapps.io/api/github/oauth/callback",
  "setupUrl": "https://<aca-app>.<region>.azurecontainerapps.io/api/github/setup",
  "webhookUrl": "https://<aca-app>.<region>.azurecontainerapps.io/api/github/webhook",
  "repositoryPermissions": {
    "contents": "read",
    "pull_requests": "write",
    "actions": "write",
    "metadata": "read"
  },
  "organizationPermissions": {},
  "events": [
    "pull_request",
    "pull_request_review",
    "workflow_run",
    "installation",
    "installation_repositories"
  ],
  "requiredSecrets": [
    "BASECOAT_EXTENSION_APP_ID",
    "BASECOAT_EXTENSION_CLIENT_ID",
    "BASECOAT_EXTENSION_CLIENT_SECRET",
    "BASECOAT_EXTENSION_WEBHOOK_SECRET",
    "BASECOAT_EXTENSION_PRIVATE_KEY_PEM"
  ],
  "requiredMetadata": [
    "app_id",
    "client_id",
    "installation_id"
  ],
  "notes": [
    "Do not commit generated credentials.",
    "Store credentials in org/repo secrets manager.",
    "requiredMetadata lists non-secret values to share in issue #1073 closure evidence.",
    "Installation must target IBuySpy-Shared organization.",
    "Share App ID, Client ID, and Installation ID with maintainers for issue #1073 closure."
  ]
}
