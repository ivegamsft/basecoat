{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivegamsft/basecoat/schemas/guidance-lock-v1.schema.json",
  "title": "Shared guidance ownership lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "guidance-lock/v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "owner",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:\\.github/(?:skills|agents|instructions|prompts)/|\\.agents/skills/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9._+@()-]+(?:/[A-Za-z0-9._+@()-]+)*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "guidanceUnit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]*$"
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
